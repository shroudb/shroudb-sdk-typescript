{
  "name": "@shroudb/sdk",
  "version": "0.1.9",
  "description": "ShrouDB unified SDK — shroudb, cipher, sigil, veil, sentry, forge, keep, courier, chronicle, stash",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
